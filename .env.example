# ==============================================================================
# Sistem Absensi Face Recognition - Environment Variables
# Copy file ini menjadi .env dan ganti semua nilai rahasia sebelum produksi!
# ==============================================================================

# --- Database (Supabase PostgreSQL + pgvector) ---
# Ambil dari Supabase Dashboard -> Project Settings -> Database -> Connection string (URI)
# Gunakan Session Pooler (port 5432) atau Direct Connection.
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
DATABASE_SSL=true

# Opsional bila memakai Docker PostgreSQL lokal:
POSTGRES_DB=absensi_face
POSTGRES_USER=absensi_user
POSTGRES_PASSWORD=change_this_strong_db_password

# --- Security & UU PDP Compliance ---
# WAJIB: 64 karakter hex (32 byte) untuk enkripsi AES-256-GCM vektor wajah.
# Generate dengan: openssl rand -hex 32
# Simpan kunci ini di luar database (env / secret manager).
FACE_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# JWT Secret untuk login Dashboard HR / Atasan / Karyawan / Admin IT
JWT_SECRET=change_this_to_a_very_long_random_jwt_secret_string
JWT_EXPIRES_IN=12h

# --- Face Service (Python FastAPI + OpenCV YuNet + SFace + Silent-Face) ---
FACE_SERVICE_URL=http://face-service:8000
FACE_SERVICE_API_KEY=internal_face_service_shared_secret

# --- Attendance Rules & Retention ---
DEFAULT_MATCH_THRESHOLD=0.45
DEFAULT_LIVENESS_THRESHOLD=0.50
DUPLICATE_WINDOW_MINUTES=5
CHECKOUT_MIN_HOURS=4
PROOF_PHOTO_RETENTION_DAYS=90
STORAGE_DIR=/app/storage/proofs

# --- Backend Server ---
PORT=4000
NODE_ENV=production
CORS_ORIGIN=http://localhost:8080
RATE_LIMIT_PER_MINUTE=60
